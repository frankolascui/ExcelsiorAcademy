# Copia este archivo como .env.local y rellena los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API). En Netlify, pon las mismas variables en
# Site configuration → Environment variables.
#
# La URL y la clave pública (anon / publishable) pueden ir en el navegador:
# la seguridad la ponen las reglas de la base de datos, no esta clave.
# NUNCA pongas aquí la clave secreta (service_role / secret).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica
